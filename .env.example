# Copiez ce fichier en ".env" et remplissez-le seulement pour déployer sur Sepolia.
# Le fichier .env ne doit JAMAIS être envoyé sur GitHub (il est dans .gitignore).

# Adresse RPC Sepolia (Alchemy, Infura, etc.)
SEPOLIA_RPC_URL=

# Clé privée d'un portefeuille de TEST uniquement (jamais celle d'un portefeuille avec de l'argent réel)
PRIVATE_KEY=

# ----- Ethereum MAINNET (ARGENT RÉEL) -----
# Adresse RPC Ethereum mainnet (Alchemy : https://eth-mainnet.g.alchemy.com/v2/VOTRE_CLE)
MAINNET_RPC_URL=

# Clé privée d'un wallet DÉDIÉ à Volria, avec seulement l'ETH nécessaire aux frais
MAINNET_PRIVATE_KEY=

# Clé API Etherscan (gratuite, sur etherscan.io > My Profile > API Keys) — pour vérifier le contrat
ETHERSCAN_API_KEY=

# Offre créée au déploiement, en VOLRIA (par défaut : 1000000)
INITIAL_SUPPLY=1000000
