{
  "name": "volria",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype éducatif de blockchain compatible EVM — jeton de test VolriaToken (VLR)",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "verify:sepolia": "hardhat verify --network sepolia",
    "estimate:mainnet": "hardhat run scripts/deploy.js --network mainnet",
    "deploy:mainnet": "CONFIRM_MAINNET=OUI hardhat run scripts/deploy.js --network mainnet",
    "verify:mainnet": "hardhat verify --network mainnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "dotenv": "^16.4.5"
  }
}
